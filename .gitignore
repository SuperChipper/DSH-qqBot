# ── 依赖与构建产物 ──
node_modules/
dist/
lib/
*.tsbuildinfo

# ── 本地凭据与环境变量 ──
.env
.env.*
!.env.example
# 从 profile 复制出的本地覆盖，可能含真实 AppID/AppSecret
cordis.patch.local.yml

# ── 本地运行态（会话、QQ 附件缓存）──
.dsh-sessions/
# 只忽略仓库根目录的运行时 media/，不能误伤 src/media/ 与 dist/media/
/media/
cordis.dev.yml

# ── 本地表情包素材 ──
# 含用户投稿/二创图片，默认不提交；确认版权与授权后可 git add -f 单独提交。
/stickers/
# 共享笔记默认在 agent cwd/notes；未配置 cwd 时也不要把笔记提交/打包
/notes/
# 跑团数据（团的状态、快照、自定义地城）与 agent 临时目录，同样默认在 cwd 下
/dnd/
/tmp/

# ── 日志 / 系统 / 编辑器 ──
*.log
pnpm-debug.log*
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
